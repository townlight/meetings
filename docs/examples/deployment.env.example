# Townlight Meetings deployment profile example.
#
# Copy this file to a deployment-specific path, replace every placeholder, keep
# the completed file out of source control, then validate it with:
#
#   python scripts/check_deployment_readiness.py --env-file path/to/deployment.env --strict
#
# OIDC mode is the preferred protected deployment profile for municipal SSO.
# Replace the placeholders with the city's identity-provider values. For
# trusted-header deployment instead, set TOWNLIGHT_MEETINGS_STAFF_AUTH_MODE=trusted_header
# and use docs/examples/trusted-header-nginx.conf.

TOWNLIGHT_MEETINGS_STAFF_AUTH_MODE=oidc
TOWNLIGHT_MEETINGS_STAFF_OIDC_PROVIDER=City Entra ID
TOWNLIGHT_MEETINGS_STAFF_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
TOWNLIGHT_MEETINGS_STAFF_OIDC_AUDIENCE=api://townlight_meetings
TOWNLIGHT_MEETINGS_STAFF_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
TOWNLIGHT_MEETINGS_STAFF_OIDC_ROLE_CLAIMS=roles,groups
TOWNLIGHT_MEETINGS_STAFF_OIDC_ALGORITHMS=RS256
TOWNLIGHT_MEETINGS_STAFF_OIDC_AUTHORIZATION_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
TOWNLIGHT_MEETINGS_STAFF_OIDC_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
TOWNLIGHT_MEETINGS_STAFF_OIDC_CLIENT_ID=<application-client-id>
TOWNLIGHT_MEETINGS_STAFF_OIDC_CLIENT_SECRET=<application-client-secret>
TOWNLIGHT_MEETINGS_STAFF_OIDC_REDIRECT_URI=https://townlight_meetings.example.gov/staff/oidc/callback
TOWNLIGHT_MEETINGS_STAFF_OIDC_SESSION_COOKIE_SECRET=<strong-random-session-cookie-secret>

# Bearer mode remains available for constrained pilots before OIDC is wired:
# TOWNLIGHT_MEETINGS_STAFF_AUTH_MODE=bearer
# TOWNLIGHT_MEETINGS_STAFF_AUTH_TOKEN_ROLES='{"replace-with-secret-token":["clerk_admin","meeting_editor"]}'

TOWNLIGHT_MEETINGS_AGENDA_INTAKE_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/agenda-intake.db
TOWNLIGHT_MEETINGS_AGENDA_ITEM_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/agenda-items.db
TOWNLIGHT_MEETINGS_MEETING_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/meetings.db
TOWNLIGHT_MEETINGS_PACKET_ASSEMBLY_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/packet-assembly.db
TOWNLIGHT_MEETINGS_NOTICE_CHECKLIST_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/notice-checklist.db
TOWNLIGHT_MEETINGS_MOTION_VOTE_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/motion-vote.db
TOWNLIGHT_MEETINGS_MINUTES_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/minutes.db
TOWNLIGHT_MEETINGS_PUBLIC_ARCHIVE_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/public-archive.db
TOWNLIGHT_MEETINGS_VENDOR_SYNC_DB_URL=sqlite+pysqlite:///C:/townlight_meetings-data/vendor-sync.db

TOWNLIGHT_MEETINGS_EXPORT_ROOT=C:/townlight_meetings-exports
TOWNLIGHT_MEETINGS_DEPLOYMENT_PREFLIGHT_DIST_ROOT=dist

# Keep scheduled vendor-network sync disabled until IT has created approved
# /vendor-live-sync/sources records, verified vendor credentials, and accepted
# live pulls from the municipal network.
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_ENABLED=false
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_SCHEDULE_ENABLED=false
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_SOURCE_IDS=
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_AUTH_SECRET_ENV=TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_SHARED_SECRET
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_AUTH_SECRET_ENV_PREFIX=TOWNLIGHT_MEETINGS_VENDOR_SECRET_
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_SHARED_SECRET=<vendor-api-secret-if-enabled>
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_REPORT_DIR=C:/townlight_meetings-exports/vendor-network-sync
TOWNLIGHT_MEETINGS_VENDOR_NETWORK_SYNC_INTERVAL_SECONDS=900
